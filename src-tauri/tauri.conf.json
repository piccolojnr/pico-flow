{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow",
  "version": "0.2.0",
  "identifier": "dev.flowlinux.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Flow",
        "url": "index.html",
        "width": 920,
        "height": 780,
        "minWidth": 760,
        "minHeight": 660,
        "visible": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private desktop voice dictation",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": [
          "pipewire-bin",
          "xclip",
          "xdotool",
          "x11-xserver-utils"
        ]
      },
      "rpm": {
        "depends": [
          "pipewire-utils",
          "xclip",
          "xdotool",
          "xrandr"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
